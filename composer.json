{
    "name": "lonelywalkersource/laravel-filesystem-oss",
    "description": "Alibaba Cloud OSS storage filesystem driver for Laravel.",
    "keywords": ["laravel", "oss", "aliyun", "filesystem", "storage"],
    "license": "MIT",
    "authors": [
        {
            "name": "lonelywalkersource"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0 | ^12.0 | ^13.0",
        "lonelywalkersource/flysystem-oss": "^1.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0 | ^10.0",
        "pestphp/pest": "^3.8",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Lonelywalksource\\LaravelFilesystemOss\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lonelywalksource\\LaravelFilesystemOss\\OssStorageServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest"
    },
    "minimum-stability": "stable",
    "repositories": [{
        "name": "flysystem-oss",
        "type": "path",
        "url": "../flysystem-oss"
    }]
}
